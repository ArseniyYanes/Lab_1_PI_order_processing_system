# ============================================================================
#  .env.example — справочник переменных окружения Python-сервисов лабы
# ============================================================================
# Значения ниже совпадают с дефолтами, которые уже прописаны в
# docker-compose.yml (секции `environment:`). Docker Compose сам подставляет
# их в контейнеры, поэтому для запуска в Docker файл .env НЕ нужен.
#
# .env.example полезен, когда:
#   • сервисы запускаются локально (не в контейнерах) — тогда их выгружают
#     в окружение;
#   • нужно переопределить хосты/имена/пароли;
#   • нужен единый «справочник всех настроек» для команды.
#
# Как использовать локально:
#   cp .env.example .env
#   set -a; source ./.env; set +a     # bash / zsh
#   python python/app.py
#
# Замечание: `.env` уже в .gitignore и в репозиторий не попадает —
# в коммит включаем только этот шаблон .env.example.

# ------------------------------------------------------------------
#  MySQL  (Flask, app.py)
# ------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=apppass
MYSQL_DATABASE=orders_db

# ------------------------------------------------------------------
#  Kafka  (producer в app.py + consumer'ы)
# ------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=order-events
# имя consumer group delivery-консьюмера; payment-consumer использует
# захардкоженный group_id "payment-group" (см. python/payment_consumer.py)
KAFKA_GROUP=delivery-group

# ------------------------------------------------------------------
#  RabbitMQ  (publisher в app.py + rabbit_worker.py)
# ------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=order-notifications

# ------------------------------------------------------------------
#  Служебные (не Python; задаются в docker-compose.yml, только для справки)
# ------------------------------------------------------------------
# Корневой пароль образа MySQL (не используется Python-кодом)
MYSQL_ROOT_PASSWORD=rootpass
# Пользователь/пароль Management-плагила RabbitMQ (UI на :15672)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
